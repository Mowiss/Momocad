{
  "id": "./",
  "name": "MomoCAD - Dessin de plan",
  "short_name": "MomoCAD",
  "lang": "fr",
  "description": "Dessin de plan technique dans le navigateur, export DXF et PDF.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1e1e1e",
  "theme_color": "#1f2937",
  "icons": [
    {
      "src": "icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-momocad": [
          ".mmc"
        ]
      },
      "icons": [
        {
          "src": "icons/mmc-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/mmc-512.png",
          "sizes": "512x512",
          "type": "image/png"
        },
        {
          "src": "icons/mmc-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "icons/mmc-32.png",
          "sizes": "32x32",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "accept": {
        "application/dxf": [
          ".dxf"
        ]
      }
    }
  ]
}